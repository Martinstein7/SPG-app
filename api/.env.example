PORT=3000

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=seu_client_id
SPOTIFY_CLIENT_SECRET=seu_client_secret
# O Spotify nao aceita "localhost" como redirect: use 127.0.0.1 e cadastre a mesma URL no Dashboard
REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Para onde o backend devolve o usuario depois do login (em producao: URL da Vercel)
FRONTEND_URL=http://localhost:5173

# IA: ordem de fallback Gemini -> Groq -> OpenAI (basta uma chave para funcionar)
GEMINI_API_KEY=sua_chave_gemini
GROQ_API_KEY=sua_chave_groq
OPENAI_API_KEY=sua_chave_openai
